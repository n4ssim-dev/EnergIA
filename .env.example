API_IMAGE_TAG=api-latest
GATEWAY_IMAGE_TAG=gateway-latest
# Image du service "langage" (ollama). Par défaut fige une version connue-stable
# pour tout le monde ; à surcharger dans son .env local si besoin (ex: une
# version plus récente pour de meilleures perfs CPU sur sa propre machine).
OLLAMA_IMAGE_TAG=0.9.2

API_PORT=8000
GATEWAY_PORT=3000

# Pour activer un override docker-compose personnel non versionné (ex: GPU
# Intel via docker-compose.local.yml), décommenter et lister tous les
# fichiers dans l'ordre (docker-compose.yml puis les overrides) :
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.local.yml
