# Used by docker-compose.yml to run the images published on Docker Hub
# (n4ssim11/energia) without cloning/building anything.
#
# Usage:
#   cp .env.example .env
#   docker compose up

# Docker Hub tags to pull (see: docker pull n4ssim11/energia:<tag>)
API_IMAGE_TAG=api-latest
GATEWAY_IMAGE_TAG=gateway-latest

# Host ports (change if 8000/3000 are already used on your machine)
API_PORT=8000
GATEWAY_PORT=3000
