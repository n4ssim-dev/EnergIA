HOST=0.0.0.0
PORT=8005

# Connexion Postgres. En local (uv run, hors docker), POSTGRES_HOST=localhost
# et POSTGRES_PORT doit correspondre au port hôte exposé par le service
# postgres-predictive de docker-compose.yml (POSTGRES_PORT, 5435 par défaut).
# Quand ms-predictive tourne via `docker compose up` avec postgres-predictive
# dans le même réseau, docker-compose.yml surcharge ces deux variables
# (POSTGRES_HOST=postgres-predictive, POSTGRES_PORT=5432) automatiquement.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=energia
POSTGRES_PASSWORD=energia
POSTGRES_DB=energia_predictive

# Connexion à la base source (ms_data, relationnelle) : d'où vient
# fait_consommation/dim_regionale. En local, POSTGRES_HOST=localhost port
# 5434 (celui exposé par le service postgres de ms_data). En docker,
# docker-compose.yml surcharge en SOURCE_POSTGRES_HOST=postgres, port 5432.
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5434
SOURCE_POSTGRES_USER=energia
SOURCE_POSTGRES_PASSWORD=energia
SOURCE_POSTGRES_DB=energia
