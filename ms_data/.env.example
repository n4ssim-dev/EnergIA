HOST=0.0.0.0
PORT=8004
API_PASSWORD=5

# Connexion Postgres. En local (uv run, hors docker), POSTGRES_HOST=localhost
# et POSTGRES_PORT doit correspondre au port hôte exposé par le service
# postgres de docker-compose.yml (POSTGRES_PORT, 5434 par défaut). Quand
# ms-data tourne via `docker compose up` avec postgres dans le même réseau,
# docker-compose.yml surcharge ces deux variables (POSTGRES_HOST=postgres,
# POSTGRES_PORT=5432) automatiquement.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=energia
POSTGRES_PASSWORD=energia
POSTGRES_DB=energia
